# ─────────────────────────────────────────────────────────────
# Global C&B 설정 (이 파일을 .env 로 복사해서 사용)
# 외부 시스템이 아직 없으면 비워두세요. 비어 있는 항목은 사이트의
# 내장 기능으로 동작하고, 화면에는 '오픈 예정'으로 표시됩니다.
# ─────────────────────────────────────────────────────────────

# ── 내장 서버 (server/index.js) ─────────────────────────────
PORT=8787
# 내부 CRM 관리 화면(#/admin) 로그인 토큰. 길고 추측하기 어려운 값으로 설정하세요.
ADMIN_TOKEN=
# 리드 저장 위치 (기본: ./data)
DATA_DIR=
# 사이트를 다른 도메인에서 호스팅할 때 신청서를 받을 수 있도록 허용할 Origin (쉼표 구분)
ALLOWED_ORIGINS=
# nginx·로드밸런서 뒤에서 운영할 때만 1 (X-Forwarded-For 로 실제 접속 IP 확인)
TRUST_PROXY=

# ── 나중에 외부 CRM 연결 ────────────────────────────────────
# 방법 1) 내장 서버가 신규 리드를 외부 CRM 웹훅으로 전달 (내장 CRM에도 계속 저장)
CRM_WEBHOOK_URL=
# 웹훅 서명 키 — 요청 헤더 X-GCNB-Signature = HMAC-SHA256(body)
CRM_WEBHOOK_SECRET=
# 방법 2) 사이트에서 외부 CRM API로 직접 전송 (비우면 내장 서버 /api/leads)
VITE_CRM_ENDPOINT=
VITE_CRM_PUBLIC_KEY=

# ── 나중에 외부 플랫폼 연결 (비우면 '오픈 예정' 표시 + 상담 신청으로 연결) ──
VITE_LMS_URL=
VITE_LEVEL_TEST_URL=
VITE_PARTNER_PORTAL_URL=
# 비우면 '직원 로그인'이 내장 CRM 관리 화면(#/admin)으로 연결됩니다.
VITE_STAFF_CRM_URL=
VITE_INSTITUTION_PORTAL_URL=

# ── 연락처 ──────────────────────────────────────────────────
VITE_CONTACT_EMAIL=contact@globalcnb.com
VITE_KAKAO_CHANNEL_URL=
