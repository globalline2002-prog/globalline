# Global C&B 플랫폼 연동 설정 (복사해서 .env 로 사용)
# 상담·파트너 신청을 받을 CRM API 엔드포인트 (POST, JSON). 비워두면 데모 모드(브라우저 저장)로 동작합니다.
VITE_CRM_ENDPOINT=
# CRM API 인증용 공개 키(선택). 서버 측에서 Origin 검증을 함께 사용하세요.
VITE_CRM_PUBLIC_KEY=
# 각 플랫폼 접속 주소
VITE_LMS_URL=https://lms.globalcnb.com
VITE_PARTNER_PORTAL_URL=https://partner.globalcnb.com
VITE_STAFF_CRM_URL=https://crm.globalcnb.com
VITE_INSTITUTION_PORTAL_URL=https://campus.globalcnb.com
VITE_LEVEL_TEST_URL=https://lms.globalcnb.com/level-test
# 대표 연락처
VITE_CONTACT_EMAIL=contact@globalcnb.com
VITE_KAKAO_CHANNEL_URL=
